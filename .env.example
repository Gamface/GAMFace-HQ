# Copy to .env and edit. Every line is optional.

# Dashboard / API
HQ_HOST=127.0.0.1
HQ_PORT=3030

# Ollama (native Windows Ollama; yours listens on 11435)
OLLAMA_URL=http://127.0.0.1:11435
HQ_MODEL=qwen3:14b
# Small model for routing + memory extraction (fits beside qwen3:14b on 16 GB)
HQ_FAST_MODEL=qwen3:4b

# Telegram: create a bot with @BotFather, then message it once to learn your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Obsidian vault folder. Agents read HQ/shared.md and HQ/agents/<agent>.md;
# the vault agent saves notes to HQ/inbox/.
OBSIDIAN_VAULT=

# Optional: hand hands-on tasks (web, files, shell) to your agenticSeek backend.
# Adds an "operator" agent. Token: docker exec backend cat /opt/agent-runtime/api_token
AGENTICSEEK_URL=
AGENTICSEEK_TOKEN=

# Memory upkeep interval and how deep delegation can go
HQ_MEMORY_INTERVAL_MIN=30
HQ_MAX_DELEGATION_DEPTH=2
