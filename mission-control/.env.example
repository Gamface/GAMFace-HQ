# Copy to .env and adjust. Values set by docker-compose.yml take precedence.
PORT=3008
HOST=127.0.0.1
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3:14b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
# true streams the model's reasoning time into the answer; false is faster
OLLAMA_THINK=false
TASK_TIMEOUT_MS=600000
# Books: how long one step (one chapter) may take before it is retried
BOOK_STEP_TIMEOUT_MS=1800000
MAX_QUEUE=20
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to require "Authorization: Bearer <token>" on run/cancel requests
HARNESS_TOKEN=

# --- Models: each agent can use its own (Team page). Cloud providers appear when a key is set ---
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# LM Studio on Windows, reached from the container:
# LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# colibri (large mixture-of-experts models from RAM/NVMe), reached from the container.
# Use the port colibri prints when it starts; keep it off 3010 and 5173.
# COLIBRI_BASE_URL=http://host.docker.internal:PORT/v1
# Model ids from  curl <COLIBRI_BASE_URL>/models  ; they become the "colibri" and
# "colibri-big" nicknames ("switch Jarvis to colibri").
# COLIBRI_MODEL=
# COLIBRI_BIG_MODEL=
# Overall monthly cap on cloud spending, in dollars, until you save one on the Team page
# (default 20; "none" starts with no cap). Cloud models with no price set go local while a cap applies.
# MONTHLY_BUDGET_USD=20
# Queue: how long the next card may wait while same-model cards run first (ms)
MODEL_GROUP_MAX_WAIT_MS=60000

# --- Brain: shared memory + canon in Postgres, MCP at /mcp (see brain/README.md) ---
# Required by docker-compose.yml. Generate with: openssl rand -hex 32
BRAIN_DB_PASSWORD=
# Embeddings for memory search (on the same Ollama; run: ollama pull nomic-embed-text)
EMBED_MODEL=nomic-embed-text
EMBED_DIMS=768
# EMBED_OLLAMA_URL=   (defaults to OLLAMA_BASE_URL)
EMBED_TIMEOUT_MS=15000
# How often the vault's HQ/ notes are copied into canon docs (minutes)
CANON_SYNC_MIN=5
# MCP sessions: idle timeout, and how many are kept at once
MCP_SESSION_TTL_MINUTES=30
MCP_MAX_SESSIONS=100
# Optional NocoDB viewer (docker compose --profile viewer up -d); set before the
# brain database's first start
# NOCODB_META_PASSWORD=
# NOCODB_RO_PASSWORD=
# NC_AUTH_JWT_SECRET=

# --- HQ features (see README-HQ.md) ---
# Model for the Vision agent (must read images: qwen3.5:latest, gemma4:12b, ...)
OLLAMA_VISION_MODEL=qwen3.5:latest
# Model for transcribing attached audio (needs the audio capability: gemma4:12b)
OLLAMA_AUDIO_MODEL=gemma4:12b
# Who turns recordings (the dashboard mic, voice notes) into text: whisper = the voice
# service's faster-whisper on the CPU, like the "Hey Jarvis" wake word (default);
# model = the Transcriber above. Whisper falls back to the Transcriber if it fails.
TRANSCRIBE_WITH=whisper
# Long attached PDFs are read in at most this many parts (about 14,000 characters each)
MAX_DOC_PARTS=10
# Routines: default time zone (the dashboard sends the browser's) and the shortest gap between runs
# ROUTINE_TZ=America/New_York
ROUTINE_MIN_MINUTES=5
# Browser profiles: encrypt saved sign-ins (keep this value: profiles can't be read without it)
# PROFILE_SECRET=
# How long you can keep an agent's browser (or a profile window) before it's handed back / closed
TAKEOVER_TIMEOUT_MIN=30
# Videos (Remotion service in docker-compose.yml): longest video, parallel render tabs, fix attempts
VIDEO_MAX_SECONDS=60
# VIDEO_CONCURRENCY=
VIDEO_FIX_ROUNDS=2
# Port Remotion serves bundles on inside the video container (not published; 3000 is avoided)
# VIDEO_BUNDLE_PORT=3100
# Voice service (docker-compose.yml): default voice; Whisper model baked in at build
# (base.en is quick; small.en times words more accurately). Rebuild after changing it.
# VOICE_DEFAULT=af_heart
# VOICE_WHISPER_MODEL=base.en
# Workspaces (folders agents may edit; see docker-compose.yml) and how much of their
# file contents goes into a request (raise it with a bigger OLLAMA_NUM_CTX)
# WORKSPACES_DIR=
WORKSPACE_CONTEXT_CHARS=12000
# Graphics card memory in GB (the Home page's VRAM bar)
GPU_VRAM_GB=16
# Small model for auto-routing and memory extraction (fits beside qwen3:14b on 16 GB)
OLLAMA_FAST_MODEL=qwen3:4b
# Where the hive log and memories are saved
DATA_DIR=./data
MEMORY_INTERVAL_MIN=30
# Obsidian vault folder (inside the container: see docker-compose.yml)
OBSIDIAN_VAULT=
# Telegram: create a bot with @BotFather, message it once to learn your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Real browsing (docker-compose.yml starts Chrome and sets BROWSER_CDP_URL)
BROWSER_CDP_URL=
BROWSER_MAX_STEPS=10

# --- Preflight voice check (npm run preflight); OpenAI-compatible endpoints ---
# e.g. Kokoro-FastAPI on :8880 and speaches (faster-whisper) on :8000
VOICE_TTS_URL=
VOICE_TTS_MODEL=kokoro
VOICE_TTS_VOICE=bm_george
VOICE_STT_URL=
VOICE_STT_MODEL=Systran/faster-whisper-small

# Etsy niche research on the Books page (free key: create an app at etsy.com/developers)
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# Themed music videos in the Studio: free stock photos and clips (keys from pexels.com/api and pixabay.com/api/docs)
PEXELS_API_KEY=
PIXABAY_API_KEY=
