{
  "name": "ts-harness",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/ui.ts",
    "start": "tsx src/ui.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/run.ts",
    "test": "tsx --test tests/hq.test.ts tests/board.test.ts tests/policy.test.ts tests/routine.test.ts tests/vision.test.ts tests/audio.test.ts tests/reply.test.ts tests/pdf.test.ts tests/docs.test.ts",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pdfjs-dist": "^6.2.108",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
